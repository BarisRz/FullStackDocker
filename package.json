{
  "name": "fullstackdocker",
  "version": "1.0.0",
  "description": "Template FullStack pour facilement déployer avec docker un projet React/Express/MySQL",
  "scripts": {
    "install": "cd frontend && npm install && cd ../backend && npm install",
    "dev-front": "cd frontend && npm run dev",
    "dev-back": "cd backend && npm run dev",
    "dev": "concurrently \"npm run dev-front\" \"npm run dev-back\"",
    "db:migrate": "cd backend && npm run db:migrate"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "concurrently": "^9.1.2"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.0",
    "@fontsource/roboto": "^5.1.1",
    "@mui/material": "^6.4.1"
  }
}
